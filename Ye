local isActive = false
local conn
local bv, bg, cam, hrp

local function stopOrbit()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if cam then cam.CameraType = Enum.CameraType.Custom cam = nil end
    if conn then conn:Disconnect() conn = nil end
end

local function startOrbit()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    hrp = character:WaitForChild("HumanoidRootPart")
    cam = workspace.CurrentCamera

    local radius = 10
    local speed = 30000
    local center = hrp.Position
    local angle = 0
    local camCFrame = cam.CFrame

    cam.CameraType = Enum.CameraType.Scriptable

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 0, 1e9)
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 1e6
    bg.Parent = hrp

    conn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not hrp or not hrp.Parent or not isActive then
            stopOrbit()
            return
        end

        -- Destroy all particles continuously
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("ParticleEmitter") then
                part:Destroy()
            end
        end

        cam.CFrame = camCFrame
        angle = angle + (speed / radius) * dt
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius
        local targetPos = Vector3.new(center.X + x, hrp.Position.Y, center.Z + z)
        local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
        hrp.CFrame = CFrame.new(targetPos, targetPos + tangent)
        bv.Velocity = tangent * speed
        bg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + tangent, Vector3.new(0, 1, 0))
    end)
end

