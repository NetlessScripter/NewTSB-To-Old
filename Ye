local function createTrail(p0, p1)
	if not (p0 and p1) then return end

	local att0 = Instance.new("Attachment")
	att0.Parent = p0

	local att1 = Instance.new("Attachment")
	att1.Parent = p1

	local trail = Instance.new("Trail")
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.Color = bodyTrailColor
	trail.Lifetime = 0.2
	trail.Transparency = NumberSequence.new(0.15)
	trail.WidthScale = NumberSequence.new(0.35)
	trail.LightEmission = 1
	trail.Parent = hrp

	table.insert(electricTrails, trail)
	table.insert(electricTrails, att0)
	table.insert(electricTrails, att1)
end

local function createElectricTrails()
	-- connect across limbs instead of single part offsets
	createTrail(char:FindFirstChild("Head"), hrp)

	createTrail(char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm"), hrp)
	createTrail(char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm"), hrp)

	createTrail(char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg"), hrp)
	createTrail(char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg"), hrp)
end

local function destroyElectricTrails()
	for _, obj in pairs(electricTrails) do
		if obj and obj.Parent then
			obj:Destroy()
		end
	end
	electricTrails = {}
end

